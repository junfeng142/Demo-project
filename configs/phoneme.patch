+
+    snprintf(jar_path, sizeof(jar_path), "%s/j2me%08x.jar", JAD_DIR, h);
+
+    /* 只卸载，不 unlink —— 挂载点文件保留 */
+    if (umount2(jar_path, MNT_DETACH) != 0) {
+        /* 没挂载或已卸载，忽略 */
+    }
+}
