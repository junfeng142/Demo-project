+/* 统一为一个游戏建立 ASCII 链接。
+ * 用 orig_path 的哈希做 ASCII 名，重复调用是幂等的。
+ * 成功后 games[idx].path 和 games[idx].config 会被就地改写为 ASCII。 */
+static void ensure_ascii_link(int idx) {
+    char ascii_name[32];
+    char ascii_jar[PATH_MAX];
+    unsigned int h;
+    const unsigned char *s;
+    struct stat st_src, st_dst;
+    int need_build;
+
+    if (idx < 0 || idx >= game_count) return;
+    if (games[idx].is_dir) return;
+    if (games[idx].orig_path[0] == '\0') return;
+
+    /* 已经处理过：path 已经在 jad/ 里 */
+    if (strncmp(games[idx].path, JAD_DIR "/", strlen(JAD_DIR) + 1) == 0) {
+        return;
+    }
+
+    /* 用原始路径的 FNV-1a 哈希做 ASCII 名 */
+    h = 2166136261u;
+    s = (const unsigned char *)games[idx].orig_path;
+    while (*s) { h = (h ^ *s++) * 16777619u; }
+    snprintf(ascii_name, sizeof(ascii_name), "j2me%08x", h);
+    snprintf(ascii_jar, sizeof(ascii_jar), "%s/%s.jar", JAD_DIR, ascii_name);
+
+    mkdir(PM_DIR, 0777);
+    mkdir(JAD_DIR, 0777);
+
+    /* 链接不存在，或者源文件比链接新，就重建 */
+    need_build = (access(ascii_jar, F_OK) != 0);
+    if (!need_build) {
+        if (stat(games[idx].orig_path, &st_src) == 0 &&
+            stat(ascii_jar, &st_dst) == 0 &&
+            st_src.st_mtime > st_dst.st_mtime) {
+            need_build = 1;
+        }
+    }
+
+    if (need_build) {
+        unlink(ascii_jar);
+        if (link(games[idx].orig_path, ascii_jar) != 0) {
+            if (copy_file(games[idx].orig_path, ascii_jar) != 0) return;
+        }
+        /* 如果原 jar 旁边有 .jad，也一起链接 */
+        {
+            int n = strlen(games[idx].orig_path);
+            if (n > 4 && strcasecmp(games[idx].orig_path + n - 4, ".jar") == 0) {
+                char orig_jad[PATH_MAX], link_jad[PATH_MAX];
+                snprintf(orig_jad, sizeof(orig_jad),
+                         "%.*s.jad", n - 4, games[idx].orig_path);
+                if (access(orig_jad, F_OK) == 0) {
+                    snprintf(link_jad, sizeof(link_jad),
+                             "%s/%s.jad", JAD_DIR, ascii_name);
+                    unlink(link_jad);
+                    if (link(orig_jad, link_jad) != 0) {
+                        copy_file(orig_jad, link_jad);
+                    }
+                }
+            }
+        }
+    }
+
+    /* 就地替换 path 和 config */
+    free(games[idx].path);
+    games[idx].path = strdup(ascii_jar);
+    snprintf(games[idx].config, sizeof(games[idx].config), "%s", ascii_name);
+}
