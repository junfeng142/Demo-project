+static void ensure_ascii_link(int idx) {
+    char ascii_name[32];
+    char ascii_jar[PATH_MAX];
+    unsigned int h;
+    const unsigned char *s;
+    struct stat st_src, st_dst;
+    int fd;
+
+    if (idx < 0 || idx >= game_count) return;
+    if (games[idx].is_dir) return;
+    if (games[idx].orig_path[0] == '\0') return;
+
+    if (strncmp(games[idx].path, JAD_DIR "/", strlen(JAD_DIR) + 1) == 0) {
+        return;
+    }
+
+    h = 2166136261u;
+    s = (const unsigned char *)games[idx].orig_path;
+    while (*s) { h = (h ^ *s++) * 16777619u; }
+    snprintf(ascii_name, sizeof(ascii_name), "j2me%08x", h);
+    snprintf(ascii_jar, sizeof(ascii_jar), "%s/%s.jar", JAD_DIR, ascii_name);
+
+    mkdir(PM_DIR, 0777);
+    mkdir(JAD_DIR, 0777);
+
+    /* 如果已经 bind mount 过（inode 和源文件一样），直接用 */
+    if (stat(ascii_jar, &st_dst) == 0 &&
+        stat(games[idx].orig_path, &st_src) == 0 &&
+        st_dst.st_ino == st_src.st_ino &&
+        st_dst.st_dev == st_src.st_dev) {
+        /* 已挂载，无需重建 */
+    } else {
+        /* 挂载点文件不存在就创建 */
+        if (access(ascii_jar, F_OK) != 0) {
+            fd = open(ascii_jar, O_WRONLY | O_CREAT | O_TRUNC, 0755);
+            if (fd < 0) {
+                FILE *dbg = fopen(PM_DIR "/link_debug.log", "a");
+                if (dbg) {
+                    fprintf(dbg, "open failed: %s errno=%d (%s)\n",
+                            ascii_jar, errno, strerror(errno));
+                    fclose(dbg);
+                }
+                return;
+            }
+            close(fd);
+        }
+
+        /* 如果之前 mount 过但源变了，先卸载再挂 */
+        umount2(ascii_jar, MNT_DETACH);
+
+        /* 尝试 bind mount */
+        errno = 0;
+        if (mount(games[idx].orig_path, ascii_jar, NULL, MS_BIND, NULL) != 0) {
+            FILE *dbg = fopen(PM_DIR "/link_debug.log", "a");
+            if (dbg) {
+                fprintf(dbg, "mount failed: src='%s' dst='%s' errno=%d (%s)\n",
+                        games[idx].orig_path, ascii_jar,
+                        errno, strerror(errno));
+                fclose(dbg);
+            }
+            return;   /* 失败就放弃 */
+        }
+    }
+
+    free(games[idx].path);
+    games[idx].path = strdup(ascii_jar);
+    snprintf(games[idx].config, sizeof(games[idx].config), "%s", ascii_name);
+}
+
