+/* 检测是否为中文字符 */
+static int is_chinese(UCodePoint ch)
+{
+	return (ch >= 0x4E00 && ch <= 0x9FFF);  /* CJK统一表意文字 */
+}
+
+void textrenderer_draw_char(TextRenderer *tr, UCodePoint ch, SDL_Surface *target, int target_x, int target_y)
+{
+#ifndef SDLFE_WITHOUT_SDL_TTF
+	/* 如果是中文字符且TTF字体可用，用TTF渲染 */
+	if (is_chinese(ch) && tr->ttf_font != NULL) {
+		char utf8_char[5] = {0};
+		/* 将Unicode码点转换为UTF-8 */
+		if (ch < 0x800) {
+			utf8_char[0] = 0xC0 | (ch >> 6);
+			utf8_char[1] = 0x80 | (ch & 0x3F);
+		} else if (ch < 0x10000) {
+			utf8_char[0] = 0xE0 | (ch >> 12);
+			utf8_char[1] = 0x80 | ((ch >> 6) & 0x3F);
+			utf8_char[2] = 0x80 | (ch & 0x3F);
+		} else {
+			utf8_char[0] = 0xF0 | (ch >> 18);
+			utf8_char[1] = 0x80 | ((ch >> 12) & 0x3F);
+			utf8_char[2] = 0x80 | ((ch >> 6) & 0x3F);
+			utf8_char[3] = 0x80 | (ch & 0x3F);
+		}
+		
+		SDL_Surface *surface = TTF_RenderUTF8_Solid(tr->ttf_font, utf8_char, tr->ttf_color);
+		if (surface) {
+			SDL_Rect drect = {target_x, target_y, surface->w, surface->h};
+			SDL_BlitSurface(surface, NULL, target, &drect);
+			SDL_FreeSurface(surface);
+			return;
+		}
+	}
+#endif
+    
 	const int n = (ch - '!') * tr->chwidth;
 	SDL_Rect  srect, drect;
 
