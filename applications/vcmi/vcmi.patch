diff -uprN a/strip.sh b/strip.sh
--- a/strip.sh	1970-01-01 08:00:00.000000000 +0800
+++ b/strip.sh	2026-04-30 09:00:24.467497834 +0800
@@ -0,0 +1,20 @@
+#!/bin/bash
+
+mkdir -p ../_opk/vcmi/AI
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/AI/libBattleAI.so -o ../_opk/vcmi/AI/libBattleAI.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/AI/libEmptyAI.so -o ../_opk/vcmi/AI/libEmptyAI.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/AI/libNullkiller.so -o ../_opk/vcmi/AI/libNullkiller.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/AI/libStupidAI.so -o ../_opk/vcmi/AI/libStupidAI.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/AI/libVCAI.so -o ../_opk/vcmi/AI/libVCAI.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/libvcmi.so -o ../_opk/vcmi/libvcmi.so
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/libvcmiclientcommon.a -o ../_opk/vcmi/libvcmiclientcommon.a
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/libvcmiservercommon.a -o ../_opk/vcmi/libvcmiservercommon.a
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/vcmiclient -o ../_opk/vcmi/vcmiclient
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip bin/vcmiserver -o ../_opk/vcmi/vcmiserver
+
+if [ ! -d "../_opk/vcmi/config" ]; then
+    cp -r bin/config/ ../_opk/vcmi
+fi
+if [ ! -d "../_opk/vcmi/Mods" ]; then
+    cp -r bin/Mods/ ../_opk/vcmi
+fi
