diff -uprN a/boost/build.sh b/boost/build.sh
--- a/boost/build.sh	1970-01-01 08:00:00.000000000 +0800
+++ b/boost/build.sh	2026-04-30 08:53:45.627496858 +0800
@@ -0,0 +1,6 @@
+#!/bin/bash
+
+./bootstrap.sh --with-libraries=date_time,filesystem,locale,program_options,iostreams,system,thread \
+               --prefix=../libs/boost 
+sed -i 's/using gcc ;/using gcc : arm : \/opt\/mmiyoo\/bin\/arm-linux-gnueabihf-g++ ;/' ./project-config.jam
+./b2 install
diff -uprN a/build.sh b/build.sh
