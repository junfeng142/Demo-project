+
+CMAKE_ARGS="-DCMAKE_SYSTEM_NAME=Linux \
+            -DCMAKE_SYSTEM_PROCESSOR=armv7l \
+            -DTBB_TEST=OFF \
+            -DCMAKE_INSTALL_PREFIX=../libs/tbb
