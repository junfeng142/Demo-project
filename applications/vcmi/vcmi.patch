@@ -0,0 +1,23 @@
+#!/bin/bash
+
+CMAKE_ARGS="-DVCMI_LAUNCHER=OFF \
+            -DENABLE_LAUNCHER=OFF \
+            -DENABLE_VIDEO=OFF \
+            -DENABLE_EDITOR=OFF \
+            -DBOOST_NO_SYSTEM_PATHS=ON \
+            -DBOOST_ROOT=./libs/boost \
+            -DBoost_DATE_TIME_LIBRARY_RELEASE=./libs/boost/lib/libboost_date_time.so \
+            -DBoost_FILESYSTEM_LIBRARY_RELEASE=./libs/boost/lib/libboost_filesystem.so \
+            -DBoost_LOCALE_LIBRARY_RELEASE=./libs/boost/lib/libboost_locale.so \
+            -DBoost_PROGRAM_OPTIONS_LIBRARY_RELEASE=./libs/boost/lib/libboost_program_options.so \
+            -DBoost_IOSTREAMS_LIBRARY_RELEASE=./libs/boost/lib/libboost_iostreams.so \
+            -DBoost_SYSTEM_LIBRARY_RELEASE=./libs/boost/lib/libboost_system.so \
+            -DCMAKE_EXE_LINKER_FLAGS="-Wl,-rpath-link,./libs/boost/lib" \
+            -Dminizip_INCLUDE_DIR=./libs/minizip/include/minizip \
+            -Dminizip_LIBRARY=./libs/minizip/lib/libminizip.so \
+            -DLIBSQUISH_LIBRARY=./libs/squish/lib/libsquish.so.0 \
+            -DLIBSQUISH_INCLUDE_DIR=./libs/squish/include \
+            -DTBB_DIR=./libs/tbb/lib/cmake/TBB \
+            -DCMAKE_TOOLCHAIN_FILE=/opt/mmiyoo/share/buildroot/toolchainfile.cmake ${CMAKE_ARGS}"
+cmake $CMAKE_ARGS .
+make -j8 V=s
