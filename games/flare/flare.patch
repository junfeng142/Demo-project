diff -uprN a/build_opk.sh b/build_opk.sh
--- a/build_opk.sh	1970-01-01 08:00:00.000000000 +0800
+++ b/build_opk.sh	2026-04-27 20:07:51.034788261 +0800
@@ -0,0 +1,16 @@
+#!/bin/bash
+
+if [ ! -d "flare-game" ]; then
+    git clone -b v1.14 https://github.com/flareteam/flare-game.git --depth 1
+    rm mods/default/fonts/unifont-10.0.06.ttf
+    cp -r mods/default/ mods.txt _opk/mods
+    cp -r flare-game/mods/alpha_demo/ flare-game/mods/centered_statbars/ flare-game/mods/devlab/ flare-game/mods/empyrean_campaign/ flare-game/mods/fantasycore/ _opk/mods
+    mv font_settings.txt _opk/mods/fantasycore/engine
+    ln -s /usr/share/fonts/droid/DroidSansFallbackFull.ttf ./unifont-10.0.06.ttf
+    mv ./unifont-10.0.06.ttf _opk/mods/default/fonts/
+fi
+CMAKE_ARGS="-DCMAKE_TOOLCHAIN_FILE=/opt/mmiyoo/share/buildroot/toolchainfile.cmake ${CMAKE_ARGS}"
+cmake $CMAKE_ARGS .
+make -j8 V=s
+/opt/mmiyoo/bin/arm-linux-gnueabihf-strip flare -o _opk/flare
+mksquashfs ./_opk/* ../_opk/flare_funkey-s.opk -all-root -no-xattrs -noappend -no-exports
